# -*- coding: utf-8 -*-
"""
Atividade 01 - Análise Exploratória e Avaliação de Qualidade dos Dados
Disciplina: Sistemas Inteligentes Orientados a Dados (PGCOMP / UFBA - 2026.2)
Projeto: Categorizador Inteligente de Gastos para Profissionais da Gig Economy (SaaS B2B2C)

Este script carrega o conjunto de dados de transações financeiras reais (com ruídos e anomalias),
identifica e quantifica problemas de qualidade, realiza a limpeza básica e plota distribuições.
"""

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import re

def main():
    print("="*80)
    print("INICIANDO PIPELINE DE ANÁLISE EXPLORATÓRIA - ATIVIDADE 01")
    print("="*80)
    
    # 1. Carregar os Dados
    data_path = "transacoes_financeiras_anonimizadas.csv"
    try:
        df = pd.read_csv(data_path)
    except FileNotFoundError:
        print(f"Erro: O arquivo '{data_path}' não foi encontrado. Certifique-se de que ele está no mesmo diretório.")
        return

    # 2. Caracterização Geral da Base (Item 5 da Atividade)
    n_registros, n_atributos = df.shape
    print(f"\n[INFO] Dimensões da Base:")
    print(f" - Número Total de Transações (Registros): {n_registros}")
    print(f" - Número de Atributos (Campos): {n_atributos}")
    print(f" - Atributos disponíveis: {list(df.columns)}")

    # 3. Avaliação Inicial da Qualidade de Dados (Item 3 da Atividade)
    print(f"\n[INFO] Diagnóstico Inicial de Qualidade dos Dados:")
    
    # 3.1. Valores Ausentes
    null_counts = df.isnull().sum()
    null_pct = (df.isnull().sum() / len(df)) * 100
    print("\n3.1. Valores Ausentes por Atributo:")
    for col in df.columns:
        print(f" - {col}: {null_counts[col]} nulos ({null_pct[col]:.2f}%)")
        
    # 3.2. Duplicidades (Chave Primária id_transacao)
    dup_total = df.duplicated().sum()
    dup_id = df.duplicated(subset=['id_transacao']).sum()
    print(f"\n3.2. Duplicidades Encontradas:")
    print(f" - Linhas completamente duplicadas: {dup_total}")
    print(f" - IDs de transações duplicados (Chave Primária): {dup_id}")

    # 3.3. Inconsistências de Formato em Datas
    print(f"\n3.3. Avaliação de Formato de Datas:")
    # Tentar converter datas para datetime e capturar erros
    datas_conversao = pd.to_datetime(df['data_transacao'], errors='coerce')
    datas_invalidas = df['data_transacao'].notnull() & datas_conversao.isnull()
    n_datas_invalidas = datas_invalidas.sum()
    print(f" - Registros de data que não puderam ser convertidos automaticamente: {n_datas_invalidas}")
    if n_datas_invalidas > 0:
        print("   Exemplos de formatos inconsistentes:")
        print(df[datas_invalidas]['data_transacao'].head(5).tolist())

    # 3.4. Registros Incorretos (Outliers Financeiros ou Erros de Sistema)
    outliers_valores = df[(df['valor'] > 50000) | (df['valor'] < -1000)]
    print(f"\n3.4. Registros Incorretos / Outliers Extremos de Valor:")
    print(f" - Transações com valores suspeitos (&gt; R$ 50.000 ou &lt; R$ -1.000): {len(outliers_valores)}")
    if len(outliers_valores) > 0:
        print(outliers_valores[['id_transacao', 'descricao_original', 'valor']].head(5))

    # 4. Tratamento e Limpeza Básica (Pipeline de Preparação)
    print(f"\n[INFO] Aplicando Tratamento e Limpeza Básica:")
    
    # Remover duplicidades exatas
    df_limpo = df.drop_duplicates(subset=['id_transacao']).copy()
    print(f" - Removidos registros duplicados. Restaram {len(df_limpo)} transações únicas.")
    
    # Padronizar datas
    df_limpo['data_datetime'] = pd.to_datetime(df_limpo['data_transacao'], errors='coerce')
    # Preencher datas nulas com a data anterior (forward fill) como estratégia de imputação temporal
    df_limpo['data_datetime'] = df_limpo['data_datetime'].ffill()
    
    # Limpeza e Padronização de Texto (NLP) para Descrições Cruas
    def limpar_texto(texto):
        if not isinstance(texto, str):
            return ""
        texto = texto.upper()
        texto = re.sub(r'PG \*', '', texto)  # Remover marcas de gateway de pagamento "PG *"
        texto = re.sub(r' BR$', '', texto)    # Remover sufixo de país " BR"
        texto = re.sub(r'- REF \d+', '', texto)  # Remover códigos de referência aleatórios
        texto = re.sub(r'#\w+', '', texto)   # Remover hashtags de sistema
        texto = re.sub(r'\s+', ' ', texto).strip() # Remover espaços em branco duplicados
        return texto

    df_limpo['descricao_limpa'] = df_limpo['descricao_original'].apply(limpar_texto)
    print(f" - Descrições padronizadas via NLP/Regex para remoção de ruídos (Ex: PG *UBER *TRIP BR -&gt; UBER TRIP)")

    # 5. Análise de Distribuição do Target (Pessoal vs. Profissional)
    print(f"\n[INFO] Distribuição das Classes (Variável-Alvo):")
    dist_target = df_limpo['tipo_conta_estimado'].value_counts()
    dist_pct = df_limpo['tipo_conta_estimado'].value_counts(normalize=True) * 100
    for idx in dist_target.index:
        print(f" - {idx}: {dist_target[idx]} transações ({dist_pct[idx]:.2f}%)")

    # 6. Dicionário de Dados Mínimo de Validação (Item 4)
    print(f"\n[INFO] Amostra do Pipeline de Dados Tratados:")
    print(df_limpo[['id_transacao', 'data_datetime', 'descricao_limpa', 'valor', 'categoria_sugerida', 'tipo_conta_estimado']].head(5))
    
    print("\n" + "="*80)
    print("ANÁLISE CONCLUÍDA! PIPELINE PRONTO PARA MODELAGEM PREDITIVA (NLP + CLASSFICADOR)")
    print("="*80)

if __name__ == "__main__":
    main()
